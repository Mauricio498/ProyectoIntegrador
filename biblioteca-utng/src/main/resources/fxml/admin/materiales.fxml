<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="books-module"
            minHeight="900"
            prefHeight="900"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="utng.biblioteca.controller.admin.MaterialesController">

    <!-- ============================================================
         ENCABEZADO Y BUSCADOR
         ============================================================ -->

    <top>
        <VBox spacing="12">
            <padding>
                <Insets top="18" right="24" bottom="12" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14">

                <VBox spacing="1">
                    <Label text="Acervo"
                           styleClass="module-title"/>

                    <Label text="Alta, edición y baja de materiales, y control de sus ejemplares."
                           styleClass="module-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnNuevo"
                        text="+ Nuevo material"
                        mnemonicParsing="false"
                        onAction="#nuevo"
                        styleClass="primary-button"/>

              <Button text="📥 Importar Excel"
                     mnemonicParsing="false"
                     onAction="#importarExcel"
                     styleClass="excel-button"/>

                <Button fx:id="btnPanel"
                        text="Mostrar formulario"
                        mnemonicParsing="false"
                        onAction="#alternarPanel"
                        styleClass="secondary-button"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">

                <TextField fx:id="txtBuscar"
                           minWidth="220"
                           promptText="Buscar por título, ISBN, autor o clasificación..."
                           HBox.hgrow="ALWAYS"
                           maxWidth="Infinity"
                           styleClass="search-field"/>

                <ComboBox fx:id="cmbTipo"
                          promptText="Tipo"
                          prefWidth="165"
                          minWidth="140"
                          styleClass="toolbar-combo"/>

                <ComboBox fx:id="cmbDisponibilidad"
                          promptText="Disponibilidad"
                          prefWidth="175"
                          minWidth="150"
                          styleClass="toolbar-combo"/>

                <Button text="Limpiar"
                        mnemonicParsing="false"
                        onAction="#limpiar"
                        styleClass="secondary-button"/>

                <Button text="Buscar"
                        mnemonicParsing="false"
                        onAction="#buscar"
                        styleClass="primary-button"/>
            </HBox>
        </VBox>
    </top>


    <!-- ============================================================
         CONTENIDO PRINCIPAL
         ============================================================ -->

    <center>

        <SplitPane fx:id="divisor"
                   dividerPositions="0.68"
                   minHeight="750"
                   prefHeight="750"
                   styleClass="divisor-modulo">

            <padding>
                <Insets top="0" right="24" bottom="24" left="24"/>
            </padding>


            <!-- ====================================================
                 COLUMNA IZQUIERDA
                 CATÁLOGO + EJEMPLARES
                 ==================================================== -->

            <VBox spacing="18"
                  minWidth="520"
                  minHeight="720"
                  prefHeight="720">


                <!-- =================================================
                     CATÁLOGO
                     ================================================= -->

                <VBox spacing="8"
                      styleClass="table-card"
                      minHeight="330"
                      prefHeight="370"
                      VBox.vgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" spacing="10">

                        <Label text="Catálogo"
                               styleClass="table-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="lblResumen"
                               text=""
                               styleClass="table-footer"/>
                    </HBox>


                    <TableView fx:id="tblMateriales"
                               minHeight="230"
                               prefHeight="280"
                               VBox.vgrow="ALWAYS"
                               styleClass="modern-table">

                        <columns>

                            <TableColumn fx:id="colIsbn"
                                         text="ISBN"
                                         prefWidth="140"/>

                            <TableColumn fx:id="colTitulo"
                                         text="Título"
                                         prefWidth="250"/>

                            <TableColumn fx:id="colAutores"
                                         text="Autores"
                                         prefWidth="180"/>

                            <TableColumn fx:id="colTipo"
                                         text="Tipo"
                                         prefWidth="110"/>

                            <TableColumn fx:id="colEditorial"
                                         text="Editorial"
                                         prefWidth="140"/>

                            <TableColumn fx:id="colEjemplares"
                                         text="Libres"
                                         prefWidth="85"/>

                            <TableColumn fx:id="colEstado"
                                         text="Estado"
                                         prefWidth="105"/>

                        </columns>

                    </TableView>


                    <!-- PAGINACIÓN -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="8"
                          styleClass="barra-paginacion">

                        <Label text="Por página"
                               styleClass="filtro-label"
                               minWidth="76"/>

                        <ComboBox fx:id="cmbPorPagina"
                                  prefWidth="80"
                                  minWidth="80"
                                  styleClass="toolbar-combo"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="lblPagina"
                               text=""
                               styleClass="table-footer"/>

                        <Button fx:id="btnAnterior"
                                text="◀"
                                mnemonicParsing="false"
                                minWidth="42"
                                styleClass="btn-pagina"/>

                        <Button fx:id="btnSiguiente"
                                text="▶"
                                mnemonicParsing="false"
                                minWidth="42"
                                styleClass="btn-pagina"/>

                    </HBox>

                </VBox>


                <!-- =================================================
                     EJEMPLARES
                     ================================================= -->

                <VBox spacing="8"
                      styleClass="table-card"
                      minHeight="300"
                      prefHeight="320"
                      VBox.vgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT"
                          spacing="10">

                        <Label text="Ejemplares"
                               styleClass="table-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="lblEjemplares"
                               text=""
                               styleClass="table-footer"/>

                    </HBox>


                    <TableView fx:id="tblEjemplares"
                               minHeight="170"
                               prefHeight="210"
                               VBox.vgrow="ALWAYS"
                               styleClass="modern-table">

                        <columns>

                            <TableColumn fx:id="colCodigo"
                                         text="Código"
                                         prefWidth="150"/>

                            <TableColumn fx:id="colBiblioteca"
                                         text="Biblioteca"
                                         prefWidth="180"/>

                            <TableColumn fx:id="colAdquisicion"
                                         text="Adquisición"
                                         prefWidth="150"/>

                            <TableColumn fx:id="colIngreso"
                                         text="Ingreso"
                                         prefWidth="110"/>

                            <TableColumn fx:id="colEstadoEjemplar"
                                         text="Estado"
                                         prefWidth="130"/>

                        </columns>

                    </TableView>


                    <!-- BOTONES DE ESTADO -->

                    <HBox spacing="8"
                          alignment="CENTER_LEFT">

                        <Button text="Disponible"
                                mnemonicParsing="false"
                                onAction="#marcarEjemplarDisponible"
                                styleClass="secondary-button"/>

                        <Button text="En reparación"
                                mnemonicParsing="false"
                                onAction="#marcarEjemplarReparacion"
                                styleClass="secondary-button"/>

                        <Button text="Extraviado"
                                mnemonicParsing="false"
                                onAction="#marcarEjemplarExtraviado"
                                styleClass="danger-button"/>

                        <Button text="Baja"
                                mnemonicParsing="false"
                                onAction="#marcarEjemplarBaja"
                                styleClass="danger-button"/>

                    </HBox>

                </VBox>

            </VBox>


            <!-- ====================================================
                 FORMULARIO
                 ==================================================== -->

            <ScrollPane fx:id="panelFormulario"
                        fitToWidth="true"
                        minWidth="320"
                        styleClass="scroll-pane">

                <content>

                    <VBox spacing="8"
                          styleClass="table-card">

                        <padding>
                            <Insets top="16"
                                    right="16"
                                    bottom="16"
                                    left="16"/>
                        </padding>


                        <Label fx:id="lblFormulario"
                               text="Nuevo material"
                               styleClass="table-title"
                               wrapText="true"/>


                        <!-- TÍTULO -->

                        <Label text="Título"
                               styleClass="filtro-label"/>

                        <TextField fx:id="txtTitulo"
                                   promptText="Título de la obra"
                                   styleClass="search-field"/>


                        <!-- ISBN -->

                        <Label text="ISBN"
                               styleClass="filtro-label"/>

                        <TextField fx:id="txtIsbn"
                                   promptText="978-0000000000"
                                   styleClass="search-field"/>


                        <!-- AÑO Y CLASIFICACIÓN -->

                        <HBox spacing="10">

                            <VBox spacing="4"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Año"
                                       styleClass="filtro-label"/>

                                <TextField fx:id="txtAnio"
                                           promptText="2024"
                                           styleClass="search-field"/>

                            </VBox>


                            <VBox spacing="4"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Clasificación"
                                       styleClass="filtro-label"/>

                                <TextField fx:id="txtClasificacion"
                                           promptText="Área temática"
                                           styleClass="search-field"/>

                            </VBox>

                        </HBox>


                        <!-- TIPO -->

                        <Label text="Tipo de material"
                               styleClass="filtro-label"/>

                        <ComboBox fx:id="cmbTipoForm"
                                  maxWidth="Infinity"
                                  styleClass="toolbar-combo"/>


                        <!-- EDITORIAL -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="8">

                            <Label text="Editorial"
                                   styleClass="filtro-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="+ Nueva"
                                    mnemonicParsing="false"
                                    onAction="#nuevaEditorial"
                                    styleClass="btn-link"/>

                        </HBox>

                        <ComboBox fx:id="cmbEditorial"
                                  maxWidth="Infinity"
                                  styleClass="toolbar-combo"/>


                        <!-- AUTORES -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="8">

                            <Label text="Autores"
                                   styleClass="filtro-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="+ Nuevo"
                                    mnemonicParsing="false"
                                    onAction="#nuevoAutor"
                                    styleClass="btn-link"/>

                        </HBox>

                        <Label text="Ctrl + clic para seleccionar varios"
                               styleClass="texto-ayuda"/>

                        <ListView fx:id="lstAutores"
                                  prefHeight="110"/>


                        <!-- GUARDAR -->

                        <HBox spacing="8">

                            <Button text="Limpiar"
                                    mnemonicParsing="false"
                                    onAction="#nuevo"
                                    styleClass="secondary-button"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"/>

                            <Button text="Guardar"
                                    mnemonicParsing="false"
                                    onAction="#guardar"
                                    styleClass="primary-button"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"/>

                        </HBox>


                        <!-- BAJA -->

                        <Button fx:id="btnBaja"
                                text="Dar de baja"
                                mnemonicParsing="false"
                                onAction="#cambiarEstadoMaterial"
                                maxWidth="Infinity"
                                styleClass="danger-button"/>


                        <Separator/>


                        <!-- REGISTRAR EJEMPLAR -->

                        <Label text="Registrar ejemplar"
                               styleClass="table-title"/>


                        <HBox alignment="CENTER_LEFT"
                              spacing="8">

                            <Label text="Código"
                                   styleClass="filtro-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="Sugerir"
                                    mnemonicParsing="false"
                                    onAction="#sugerirCodigo"
                                    styleClass="btn-link"/>

                        </HBox>

                        <TextField fx:id="txtCodigoEjemplar"
                                   promptText="UTNG-0001-01"
                                   styleClass="search-field"/>


                        <Label text="Número de adquisición"
                               styleClass="filtro-label"/>

                        <TextField fx:id="txtNumeroAdquisicion"
                                   promptText="ADQ-2026-001"
                                   styleClass="search-field"/>


                        <Label text="Biblioteca"
                               styleClass="filtro-label"/>

                        <ComboBox fx:id="cmbBiblioteca"
                                  maxWidth="Infinity"
                                  styleClass="toolbar-combo"/>


                        <Label text="Fecha de ingreso"
                               styleClass="filtro-label"/>

                        <DatePicker fx:id="dpIngreso"
                                    maxWidth="Infinity"
                                    styleClass="date-picker"/>


                        <Button text="Agregar ejemplar"
                                mnemonicParsing="false"
                                onAction="#agregarEjemplar"
                                maxWidth="Infinity"
                                styleClass="primary-button"/>

                    </VBox>

                </content>

            </ScrollPane>

        </SplitPane>

    </center>

</BorderPane>