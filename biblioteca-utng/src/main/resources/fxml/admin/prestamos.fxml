<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      fillWidth="true"
      minHeight="1050"
      prefHeight="1050"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="utng.biblioteca.controller.admin.PrestamosAdminController">

    <padding>
        <Insets top="24" right="30" bottom="30" left="30"/>
    </padding>


    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <HBox alignment="CENTER_LEFT" spacing="12">

        <VBox spacing="4">

            <Label text="Préstamos y devoluciones"
                   styleClass="module-title"/>

            <Label text="Autoriza las solicitudes y registra la entrega de los materiales."
                   styleClass="module-subtitle"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Actualizar"
                mnemonicParsing="false"
                onAction="#cargarTodo"
                styleClass="secondary-button"/>

    </HBox>


    <!-- ============================================================
         SOLICITUDES DE PRÉSTAMO
         ============================================================ -->

    <VBox spacing="12"
          styleClass="table-card"
          minHeight="410"
          prefHeight="410">

        <!-- ENCABEZADO -->

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <Label text="Solicitudes de préstamo"
                   styleClass="table-title"/>

            <CheckBox fx:id="chkSoloPendientes"
                      text="Solo pendientes"
                      onAction="#cargarSolicitudes"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblSolicitudes"
                   text=""
                   styleClass="table-footer"/>

        </HBox>


        <!-- ACCIONES -->

        <HBox alignment="CENTER_RIGHT"
              spacing="8">

            <Button text="Rechazar"
                    mnemonicParsing="false"
                    onAction="#rechazar"
                    styleClass="secondary-button"/>

            <Button text="Aprobar y prestar"
                    mnemonicParsing="false"
                    onAction="#aprobar"
                    styleClass="primary-button"/>

        </HBox>


        <!-- TABLA -->

        <TableView fx:id="tblSolicitudes"
                   minHeight="250"
                   prefHeight="270"
                   VBox.vgrow="ALWAYS"
                   styleClass="modern-table">

            <columns>

                <TableColumn fx:id="colSolUsuario"
                             text="Solicitante"
                             prefWidth="180"/>

                <TableColumn fx:id="colSolRol"
                             text="Rol"
                             prefWidth="110"/>

                <TableColumn fx:id="colSolMaterial"
                             text="Material"
                             prefWidth="280"/>

                <TableColumn fx:id="colSolDisponibles"
                             text="Libres"
                             prefWidth="80"/>

                <TableColumn fx:id="colSolCupo"
                             text="Cupo"
                             prefWidth="90"/>

                <TableColumn fx:id="colSolFecha"
                             text="Solicitado"
                             prefWidth="140"/>

                <TableColumn fx:id="colSolEstado"
                             text="Estado"
                             prefWidth="110"/>

                <TableColumn fx:id="colSolAviso"
                             text="Aviso"
                             prefWidth="140"/>

            </columns>

        </TableView>


        <!-- PAGINACIÓN -->

        <HBox alignment="CENTER_LEFT"
              spacing="8"
              styleClass="barra-paginacion">

            <Label text="Por página"
                   styleClass="filtro-label"
                   minWidth="76"/>

            <ComboBox fx:id="cmbSolPorPagina"
                      prefWidth="80"
                      minWidth="80"
                      styleClass="toolbar-combo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblSolPagina"
                   text=""
                   styleClass="table-footer"/>

            <Button fx:id="btnSolAnterior"
                    text="◀"
                    mnemonicParsing="false"
                    minWidth="42"
                    styleClass="btn-pagina"/>

            <Button fx:id="btnSolSiguiente"
                    text="▶"
                    mnemonicParsing="false"
                    minWidth="42"
                    styleClass="btn-pagina"/>

        </HBox>

    </VBox>


    <Separator/>


    <!-- ============================================================
         PRÉSTAMOS VIGENTES
         ============================================================ -->

    <VBox spacing="12"
          styleClass="table-card"
          minHeight="500"
          prefHeight="500">

        <!-- ENCABEZADO -->

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <Label text="Materiales prestados"
                   styleClass="table-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblPrestamos"
                   text=""
                   styleClass="table-footer"/>

        </HBox>


        <!-- ACCIONES -->

        <HBox alignment="CENTER_RIGHT"
              spacing="8">

            <Button text="Marcar extraviado"
                    mnemonicParsing="false"
                    onAction="#marcarExtraviado"
                    styleClass="secondary-button"/>

            <Button text="Registrar devolución"
                    mnemonicParsing="false"
                    onAction="#devolver"
                    styleClass="primary-button"/>

        </HBox>


        <!-- BUSCADOR -->

        <HBox alignment="CENTER_LEFT"
              spacing="12">

            <TextField fx:id="txtBuscar"
                       promptText="Buscar por usuario, material o código de ejemplar..."
                       prefWidth="420"
                       HBox.hgrow="ALWAYS"
                       styleClass="search-field"/>

            <CheckBox fx:id="chkSoloSinDevolver"
                      text="Solo sin devolver"
                      onAction="#cargarPrestamos"/>

            <Region HBox.hgrow="ALWAYS"/>

        </HBox>


        <!-- TABLA -->

        <TableView fx:id="tblPrestamos"
                   minHeight="300"
                   prefHeight="320"
                   VBox.vgrow="ALWAYS"
                   styleClass="modern-table">

            <columns>

                <TableColumn fx:id="colUsuario"
                             text="Usuario"
                             prefWidth="200"/>

                <TableColumn fx:id="colMaterial"
                             text="Material"
                             prefWidth="280"/>

                <TableColumn fx:id="colEjemplar"
                             text="Ejemplar"
                             prefWidth="150"/>

                <TableColumn fx:id="colPrestado"
                             text="Prestado"
                             prefWidth="140"/>

                <TableColumn fx:id="colLimite"
                             text="Fecha límite"
                             prefWidth="120"/>

                <TableColumn fx:id="colRetraso"
                             text="Retraso"
                             prefWidth="110"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="130"/>

            </columns>

        </TableView>


        <!-- PAGINACIÓN -->

        <HBox alignment="CENTER_LEFT"
              spacing="8"
              styleClass="barra-paginacion">

            <Label text="Por página"
                   styleClass="filtro-label"
                   minWidth="76"/>

            <ComboBox fx:id="cmbPresPorPagina"
                      prefWidth="80"
                      minWidth="80"
                      styleClass="toolbar-combo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblPresPagina"
                   text=""
                   styleClass="table-footer"/>

            <Button fx:id="btnPresAnterior"
                    text="◀"
                    mnemonicParsing="false"
                    minWidth="42"
                    styleClass="btn-pagina"/>

            <Button fx:id="btnPresSiguiente"
                    text="▶"
                    mnemonicParsing="false"
                    minWidth="42"
                    styleClass="btn-pagina"/>

        </HBox>

    </VBox>

</VBox>