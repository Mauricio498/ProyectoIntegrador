<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1280" prefHeight="760"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="utng.biblioteca.controller.admin.AdminShellController">

    <!-- ================= BARRA SUPERIOR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" prefHeight="70" minHeight="70" maxHeight="70"
              styleClass="top-bar">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <!-- ESPACIO DEL LOGOTIPO: sustituye src/main/resources/images/logo.png
                 por el archivo definitivo, conservando el nombre y la ruta. -->
            <StackPane styleClass="logo-container">
                <ImageView fitHeight="38" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@../../images/logo.png"/>
                    </image>
                </ImageView>
            </StackPane>

            <Label text="Biblioteca UTNG" styleClass="title-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="lblUsuario" text="Usuario" styleClass="user-label"/>
                <Label fx:id="lblRol" text="Rol" styleClass="sidebar-version"/>
            </VBox>

            <Button text="⏻ Cerrar sesion" mnemonicParsing="false" focusTraversable="false"
                    onAction="#cerrarSesion" styleClass="logout-button"/>
        </HBox>
    </top>

    <!-- ================= MENU LATERAL ================= -->
    <left>
        <VBox alignment="TOP_CENTER" spacing="8" prefWidth="250" minWidth="250" maxWidth="250"
              styleClass="sidebar">
            <padding>
                <Insets top="20" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Panel de gestión" alignment="CENTER" maxWidth="Infinity"
                   styleClass="sidebar-title"/>
            <Label text="Acervo, usuarios y operación diaria" wrapText="true" alignment="CENTER"
                   maxWidth="Infinity" styleClass="sidebar-subtitle"/>

            <Separator/>

            <Button fx:id="btnDashboard" text="🏠   Tablero" mnemonicParsing="false"
                    focusTraversable="false" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#abrirDashboard" styleClass="sidebar-button"/>

            <Button fx:id="btnMateriales" text="📚   Acervo" mnemonicParsing="false"
                    focusTraversable="false" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#abrirMateriales" styleClass="sidebar-button"/>

            <Button fx:id="btnPrestamos" text="🔄   Préstamos" mnemonicParsing="false"
                    focusTraversable="false" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#abrirPrestamos" styleClass="sidebar-button"/>

            <Button fx:id="btnUsuarios" text="👥   Usuarios" mnemonicParsing="false"
                    focusTraversable="false" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#abrirUsuarios" styleClass="sidebar-button"/>

            <Button fx:id="btnMultas" text="💰   Multas" mnemonicParsing="false"
                    focusTraversable="false" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#abrirMultas" styleClass="sidebar-button"/>

            <Button fx:id="btnSolicitudes" text="📄   Solicitudes" mnemonicParsing="false"
                    focusTraversable="false" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#abrirSolicitudes" styleClass="sidebar-button"/>

            <Button fx:id="btnEstadisticas" text="📊   Reportes" mnemonicParsing="false"
                    focusTraversable="false" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#abrirEstadisticas" styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>

            <Label text="Biblioteca UTNG v1.0.0" alignment="CENTER" maxWidth="Infinity"
                   styleClass="sidebar-version"/>
            <Label text="© Universidad Tecnologica del Norte de Guanajuato" wrapText="true"
                   alignment="CENTER" maxWidth="Infinity" styleClass="sidebar-footer"/>
        </VBox>
    </left>

    <!-- ================= AREA DE MODULOS ================= -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                    styleClass="scroll-pane">
            <content>
                <StackPane fx:id="contenido"/>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
