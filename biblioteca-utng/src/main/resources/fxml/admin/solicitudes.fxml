<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" fillWidth="true" styleClass="books-module"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="utng.biblioteca.controller.admin.SolicitudesController">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4">
            <Label text="Solicitudes de adquisición" styleClass="module-title"/>
            <Label text="Títulos que la comunidad pide que se compren para la biblioteca."
                   styleClass="module-subtitle" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cmbEstado" prefWidth="170" styleClass="toolbar-combo"/>
        <Button text="Actualizar" mnemonicParsing="false" onAction="#cargar"
                styleClass="secondary-button"/>
    </HBox>

    <Separator/>

    <VBox spacing="12" styleClass="table-card" VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Bandeja" styleClass="table-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblResumen" text="" styleClass="table-footer"/>
        </HBox>

        <TableView fx:id="tblSolicitudes" VBox.vgrow="ALWAYS" styleClass="modern-table" minHeight="200" prefHeight="200">
            <columns>
                <TableColumn fx:id="colSolicitante" text="Solicitante" prefWidth="200"/>
                <TableColumn fx:id="colTitulo"      text="Título" prefWidth="280"/>
                <TableColumn fx:id="colAutor"       text="Autor" prefWidth="180"/>
                <TableColumn fx:id="colEditorial"   text="Editorial" prefWidth="160"/>
                <TableColumn fx:id="colIsbn"        text="ISBN" prefWidth="150"/>
                <TableColumn fx:id="colFecha"       text="Solicitada" prefWidth="150"/>
                <TableColumn fx:id="colEstado"      text="Estado" prefWidth="120"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="barra-paginacion">
            <Label text="Por página" styleClass="filtro-label" minWidth="76"/>
            <ComboBox fx:id="cmbPorPagina" prefWidth="80" minWidth="80" styleClass="toolbar-combo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblPagina" text="" styleClass="table-footer"/>
            <Button fx:id="btnAnterior" text="◀" mnemonicParsing="false" minWidth="42" styleClass="btn-pagina"/>
            <Button fx:id="btnSiguiente" text="▶" mnemonicParsing="false" minWidth="42" styleClass="btn-pagina"/>
        </HBox>
    </VBox>

    <!-- ==================== DETALLE Y RESPUESTA ==================== -->
    <VBox spacing="12" styleClass="table-card">

        <Label fx:id="lblDetalleTitulo" text="Selecciona una solicitud" styleClass="table-title"
               wrapText="true"/>
        <Label fx:id="lblDetalleSolicitante" text="" styleClass="table-footer" wrapText="true"/>

        <HBox spacing="16">

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Justificación del solicitante" styleClass="filtro-label"/>
                <TextArea fx:id="txtDescripcion" prefHeight="110" wrapText="true" editable="false"
                          styleClass="search-field"/>
            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Respuesta de la biblioteca" styleClass="filtro-label"/>
                <TextArea fx:id="txtRespuesta" prefHeight="110" wrapText="true"
                          promptText="Obligatoria al rechazar" styleClass="search-field"/>
            </VBox>

        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Rechazar" mnemonicParsing="false" onAction="#rechazar"
                    styleClass="danger-button"/>
            <Button text="Aprobar" mnemonicParsing="false" onAction="#aprobar"
                    styleClass="primary-button"/>
        </HBox>

    </VBox>

</VBox>
