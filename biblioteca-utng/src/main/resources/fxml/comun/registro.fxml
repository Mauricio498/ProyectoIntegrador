<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" styleClass="screen-scroll"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="utng.biblioteca.controller.comun.RegistroController">
    <content>
        <HBox alignment="CENTER" styleClass="login-fondo">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox alignment="CENTER" spacing="12" maxWidth="520" styleClass="login-card">

                <padding>
                    <Insets top="32" right="44" bottom="32" left="44"/>
                </padding>

                <!-- ESPACIO DEL LOGOTIPO: sustituye src/main/resources/images/logo.png
                     por el archivo definitivo, conservando el nombre y la ruta. -->
                <StackPane styleClass="logo-container">
                    <ImageView fitHeight="64" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../../images/logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>

                <Label text="Crear cuenta" styleClass="login-titulo"/>
                <Label text="Para estudiantes y personal docente de la UTNG"
                       styleClass="section-subtitle" wrapText="true"/>

                <Separator/>

                <VBox spacing="4" maxWidth="Infinity">
                    <Label text="Tipo de cuenta" styleClass="filtro-label"/>
                    <ComboBox fx:id="cmbRol" maxWidth="Infinity" styleClass="filtro-combo"/>
                </VBox>

                <VBox spacing="4" maxWidth="Infinity">
                    <Label fx:id="lblArea" text="Área académica" styleClass="filtro-label"/>
                    <ComboBox fx:id="cmbArea" maxWidth="Infinity" styleClass="filtro-combo"/>
                </VBox>

                <VBox spacing="4" maxWidth="Infinity">
                    <Label fx:id="lblMatricula" text="Número de control" styleClass="filtro-label"/>
                    <TextField fx:id="txtNumeroControl" promptText="A00123456"
                               styleClass="search-field"/>
                </VBox>

                <VBox spacing="4" maxWidth="Infinity">
                    <Label text="Nombre completo" styleClass="filtro-label"/>
                    <TextField fx:id="txtNombre" promptText="Nombre y apellidos"
                               styleClass="search-field"/>
                </VBox>

                <VBox spacing="4" maxWidth="Infinity">
                    <Label text="Correo institucional" styleClass="filtro-label"/>
                    <TextField fx:id="txtCorreo" promptText="usuario@utng.edu.mx"
                               styleClass="search-field"/>
                </VBox>

                <VBox spacing="4" maxWidth="Infinity">
                    <Label text="Teléfono (opcional)" styleClass="filtro-label"/>
                    <TextField fx:id="txtTelefono" promptText="10 dígitos"
                               styleClass="search-field"/>
                </VBox>

                <Separator/>

                <VBox spacing="4" maxWidth="Infinity">
                    <Label text="Usuario" styleClass="filtro-label"/>
                    <TextField fx:id="txtUsuario" promptText="Con el que iniciarás sesión"
                               styleClass="search-field"/>
                </VBox>

                <HBox spacing="12" maxWidth="Infinity">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Contraseña" styleClass="filtro-label"/>
                        <PasswordField fx:id="txtPassword" promptText="Mínimo 6 caracteres"
                                       styleClass="search-field"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Confirmar" styleClass="filtro-label"/>
                        <PasswordField fx:id="txtPassword2" promptText="Repite la contraseña"
                                       styleClass="search-field"/>
                    </VBox>
                </HBox>

                <Label fx:id="lblMensaje" text="" wrapText="true" visible="false" managed="false"
                       maxWidth="Infinity" styleClass="login-error"/>

                <Button fx:id="btnRegistrar" text="Crear cuenta" onAction="#registrar"
                        maxWidth="Infinity" styleClass="btn-primary"/>

                <Button text="Ya tengo cuenta, volver al acceso" onAction="#volver"
                        maxWidth="Infinity" styleClass="btn-link"/>

                <Label wrapText="true" textAlignment="CENTER" maxWidth="Infinity"
                       styleClass="texto-legal"
                       text="Los datos que registres son verificados por el personal de biblioteca. Una cuenta con información falsa puede ser dada de baja."/>

                <Region minHeight="2"/>

            </VBox>

        </HBox>
    </content>
</ScrollPane>
