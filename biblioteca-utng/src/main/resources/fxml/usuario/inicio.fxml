<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="screen-scroll"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="utng.biblioteca.controller.usuario.InicioController">
    <content>
        <VBox spacing="32" styleClass="screen-container">
            <padding>
                <Insets top="32" right="40" bottom="40" left="40"/>
            </padding>

            <VBox styleClass="hero-card" spacing="14">
                <Label fx:id="lblSaludo" text="Hola" styleClass="hero-title" wrapText="true"/>
                <Label fx:id="lblSubtitulo" text="" styleClass="hero-subtitle"
                       wrapText="true" maxWidth="640"/>
                <Button text="Buscar en el cátalogo" styleClass="btn-primary" onAction="#irAlBuscador"/>
            </VBox>

            <HBox fx:id="contenedorEstadisticas" spacing="20"/>

            <VBox spacing="16">
                <Label text="Materiales destacados" styleClass="section-title"/>
                <TilePane fx:id="contenedorDestacados" hgap="20" vgap="20" prefColumns="4"/>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
