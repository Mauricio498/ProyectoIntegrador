<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="app-root"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="utng.biblioteca.controller.usuario.UsuarioShellController">

    <left>
        <VBox styleClass="sidebar" prefWidth="240" minWidth="220">
            <padding>
                <Insets top="28" right="18" bottom="24" left="24"/>
            </padding>

            <!-- ESPACIO DEL LOGOTIPO: sustituye src/main/resources/images/logo.png
                 por el archivo definitivo, conservando el nombre y la ruta. -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane styleClass="sidebar-logo">
                    <ImageView fitHeight="42" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../../images/logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label text="Biblioteca" styleClass="sidebar-logo-text"/>
                    <Label text="UTNG" styleClass="sidebar-logo-subtext"/>
                </VBox>
            </HBox>

            <VBox styleClass="nav-list" spacing="6">
                <padding>
                    <Insets top="36"/>
                </padding>
                <Button fx:id="btnInicio"    text="🏠  Inicio"    styleClass="nav-button"
                        onAction="#abrirInicio"    maxWidth="Infinity"/>
                <Button fx:id="btnBuscador"  text="🔍  Buscador"  styleClass="nav-button"
                        onAction="#abrirBuscador"  maxWidth="Infinity"/>
                <Button fx:id="btnPrestamos" text="📖  Préstamos" styleClass="nav-button"
                        onAction="#abrirPrestamos" maxWidth="Infinity"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnCerrarSesion" text="Cerrar sesión" styleClass="nav-button"
                    onAction="#cerrarSesion" maxWidth="Infinity"/>

            <Label text="© Universidad Tecnológica del Norte de Guanajuato"
                   styleClass="sidebar-footer" wrapText="true"/>
        </VBox>
    </left>

    <center>
        <BorderPane styleClass="content-wrapper">
            <top>
                <HBox styleClass="top-bar" alignment="CENTER_RIGHT" spacing="12">
                    <padding>
                        <Insets top="16" right="32" bottom="16" left="32"/>
                    </padding>
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="lblNombre" text="Usuario" styleClass="top-bar-nombre"/>
                        <Label fx:id="lblRol" text="Rol" styleClass="top-bar-rol"/>
                    </VBox>
                    <StackPane styleClass="avatar-circle">
                        <Circle radius="20"/>
                        <Label fx:id="lblIniciales" text="U" styleClass="avatar-label"/>
                    </StackPane>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contenido" styleClass="content-area"/>
            </center>
        </BorderPane>
    </center>

</BorderPane>
