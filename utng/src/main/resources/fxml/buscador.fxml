<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="screen-scroll"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.utng.biblioteca.controller.BuscadorController">
    <content>
        <VBox spacing="24" styleClass="screen-container">
            <padding>
                <Insets top="32" right="40" bottom="40" left="40"/>
            </padding>

            <Label text="Catálogo de la biblioteca" styleClass="page-title"/>

            <!-- BARRA DE BÚSQUEDA -->
            <HBox spacing="12" styleClass="search-bar" alignment="CENTER_LEFT">
                <TextField fx:id="txtBusqueda" promptText="Buscar por título, autor o ISBN..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnBuscar" text="Buscar" styleClass="btn-primary" onAction="#onBuscar"/>
            </HBox>

            <!-- FILTROS -->
            <HBox spacing="16" styleClass="filtros-card" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Categoría" styleClass="filtro-label"/>
                    <ComboBox fx:id="comboCategoria" styleClass="filtro-combo" prefWidth="190"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Autor" styleClass="filtro-label"/>
                    <ComboBox fx:id="comboAutor" styleClass="filtro-combo" prefWidth="190"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Disponibilidad" styleClass="filtro-label"/>
                    <ComboBox fx:id="comboDisponibilidad" styleClass="filtro-combo" prefWidth="160"/>
                </VBox>
                <VBox VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnAplicarFiltros" text="Aplicar filtros" styleClass="btn-secondary" onAction="#onAplicarFiltros"/>
            </HBox>

            <!-- RESULTADOS -->
            <Label fx:id="lblResultados" text="12 libros encontrados" styleClass="section-subtitle"/>
            <TilePane fx:id="resultadosContainer" hgap="20" vgap="20" prefColumns="4"/>
        </VBox>
    </content>
</ScrollPane>
