<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="root" stylesheets="@../css/style.css" styleClass="app-root"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.utng.biblioteca.controller.MainController">

    <left>
        <VBox styleClass="sidebar" prefWidth="240" minWidth="220">
            <padding>
                <Insets top="28" right="18" bottom="24" left="24"/>
            </padding>

            <HBox styleClass="sidebar-logo" spacing="10">
                <Label text="📚" styleClass="sidebar-logo-icon"/>
                <VBox>
                    <Label text="Biblioteca" styleClass="sidebar-logo-text"/>
                    <Label text="UTNG" styleClass="sidebar-logo-subtext"/>
                </VBox>
            </HBox>

            <VBox styleClass="nav-list" spacing="6">
                <padding>
                    <Insets top="36"/>
                </padding>
                <Button fx:id="btnInicio" text="🏠  Inicio" styleClass="nav-button" onAction="#irAInicio" maxWidth="Infinity"/>
                <Button fx:id="btnBuscador" text="🔍  Buscador" styleClass="nav-button" onAction="#irABuscador" maxWidth="Infinity"/>
                <Button fx:id="btnPrestamos" text="📖  Préstamos" styleClass="nav-button" onAction="#irAPrestamos" maxWidth="Infinity"/>
                <Button fx:id="btnPerfil" text="👤  Perfil" styleClass="nav-button" onAction="#irAPerfil" maxWidth="Infinity"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label text="© 2026 Universidad Tecnológica" styleClass="sidebar-footer" wrapText="true"/>
        </VBox>
    </left>

    <center>
        <BorderPane styleClass="content-wrapper">
            <top>
                <HBox styleClass="top-bar" alignment="CENTER_RIGHT" spacing="12">
                    <padding>
                        <Insets top="16" right="32" bottom="16" left="32"/>
                    </padding>
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="lblNombreUsuario" text="Ana Martínez Jasso" styleClass="top-bar-nombre"/>
                        <Label text="Estudiante UTNG" styleClass="top-bar-rol"/>
                    </VBox>
                    <StackPane styleClass="avatar-circle">
                        <Circle radius="20"/>
                        <Label fx:id="lblIniciales" text="AM" styleClass="avatar-label"/>
                    </StackPane>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentArea" styleClass="content-area"/>
            </center>
        </BorderPane>
    </center>

</BorderPane>
