<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="screen-scroll"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.utng.biblioteca.controller.PerfilController">
    <content>
        <VBox spacing="24" styleClass="screen-container">
            <padding>
                <Insets top="32" right="40" bottom="40" left="40"/>
            </padding>

            <Label text="Mi perfil" styleClass="page-title"/>

            <HBox spacing="24">
                <!-- TARJETA DE USUARIO -->
                <VBox styleClass="info-card" spacing="14" prefWidth="320" alignment="TOP_CENTER">
                    <StackPane styleClass="avatar-grande">
                        <Label fx:id="lblIniciales" styleClass="avatar-grande-label"/>
                    </StackPane>
                    <Label fx:id="lblNombre" styleClass="perfil-nombre"/>
                    <Label fx:id="lblMatricula" styleClass="perfil-dato"/>
                    <Label fx:id="lblCorreo" styleClass="perfil-dato"/>
                    <Button fx:id="btnEditarPerfil" text="Editar perfil" styleClass="btn-secondary" onAction="#onEditarPerfil" maxWidth="Infinity"/>
                </VBox>

                <!-- TABS -->
                <TabPane fx:id="tabPane" styleClass="tabs-modernas" HBox.hgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                    <Tab text="Préstamos activos">
                        <VBox spacing="12" styleClass="tab-contenido">
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                            <TableView fx:id="tablaActivos" styleClass="tabla-moderna" minHeight="220">
                                <columns>
                                    <TableColumn fx:id="colActivoLibro" text="Libro" prefWidth="220"/>
                                    <TableColumn fx:id="colActivoPrestamo" text="Préstamo" prefWidth="130"/>
                                    <TableColumn fx:id="colActivoDevolucion" text="Devolución" prefWidth="130"/>
                                    <TableColumn fx:id="colActivoEstado" text="Estado" prefWidth="130"/>
                                    <TableColumn fx:id="colActivoAcciones" text="Acciones" prefWidth="180"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="Historial">
                        <VBox spacing="12" styleClass="tab-contenido">
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                            <TableView fx:id="tablaHistorial" styleClass="tabla-moderna" minHeight="220">
                                <columns>
                                    <TableColumn fx:id="colHistLibro" text="Libro" prefWidth="240"/>
                                    <TableColumn fx:id="colHistPrestamo" text="Préstamo" prefWidth="140"/>
                                    <TableColumn fx:id="colHistDevolucion" text="Devolución" prefWidth="140"/>
                                    <TableColumn fx:id="colHistEstado" text="Estado" prefWidth="140"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="Datos personales" fx:id="tabDatosPersonales">
                        <VBox spacing="16" styleClass="tab-contenido">
                            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                            <VBox spacing="4">
                                <Label text="Nombre completo" styleClass="filtro-label"/>
                                <TextField fx:id="txtNombreCompleto" styleClass="filtro-combo" disable="true"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Matrícula" styleClass="filtro-label"/>
                                <TextField fx:id="txtMatricula" styleClass="filtro-combo" disable="true"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Correo electrónico" styleClass="filtro-label"/>
                                <TextField fx:id="txtCorreo" styleClass="filtro-combo"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Teléfono" styleClass="filtro-label"/>
                                <TextField fx:id="txtTelefono" styleClass="filtro-combo"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Carrera" styleClass="filtro-label"/>
                                <TextField fx:id="txtCarrera" styleClass="filtro-combo"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Grupo" styleClass="filtro-label"/>
                                <TextField fx:id="txtGrupo" styleClass="filtro-combo"/>
                            </VBox>

                            <Button fx:id="btnGuardarCambios" text="Guardar cambios" styleClass="btn-primary" onAction="#onGuardarCambios"/>
                        </VBox>
                    </Tab>
                </TabPane>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
