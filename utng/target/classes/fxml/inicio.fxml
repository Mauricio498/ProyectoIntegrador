<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="screen-scroll"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.utng.biblioteca.controller.InicioController">
    <content>
        <VBox spacing="32" styleClass="screen-container">
            <padding>
                <Insets top="32" right="40" bottom="40" left="40"/>
            </padding>

            <!-- HERO -->
            <VBox styleClass="hero-card" spacing="14">
                <Label text="Bienvenida a la Biblioteca Digital" styleClass="hero-title" wrapText="true"/>
                <Label text="Consulta el catálogo, solicita préstamos y da seguimiento a tus lecturas desde un solo lugar."
                       styleClass="hero-subtitle" wrapText="true" maxWidth="620"/>
                <Button fx:id="btnBuscarCatalogo" text="Buscar en el catálogo" styleClass="btn-primary" onAction="#onBuscarCatalogo"/>
            </VBox>

            <!-- ESTADÍSTICAS -->
            <HBox fx:id="statsContainer" spacing="20"/>

            <!-- LIBROS DESTACADOS -->
            <VBox spacing="16">
                <Label text="Libros destacados" styleClass="section-title"/>
                <TilePane fx:id="destacadosContainer" hgap="20" vgap="20" prefColumns="4"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
